{
  "version": 2,
  "services": {
    "cap": {
      "root": ".",
      "buildCommand": "npm run build:client",
      "outputDirectory": "dist/client",
      "routes": [
        { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
        { "src": "/favicon.svg" },
        { "src": "/manifest.webmanifest" },
        { "src": "/og.png" },
        { "src": "/(.*)", "dest": "/index.html", "status": 200 }
      ]
    }
  }
}
